  "domains": ["company", "accounts", "customers", "contacts", "leads", "opportunities", "services", "campaigns", "talent", "skills", "staff", "contracts", "projects", "milestones", "tasks", "time_entries", "expenses", "invoices", "credit_notes", "payments", "support_tickets", "meetings", "conversations", "notes", "activities", "knowledge", "knowledge_versions", "story_events"]
